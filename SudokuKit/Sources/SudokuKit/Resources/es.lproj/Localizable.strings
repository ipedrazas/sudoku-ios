/* SudokuKit — la letra que enseña.

   Las unidades llevan su artículo ("la fila 4", "el bloque 4"), así que ninguna
   frase puede colocar delante de %@ una preposición que se contraiga con él:
   siempre "en", nunca "de" ni "a", porque "de el bloque 4" no es español y desde
   aquí no hay forma de arreglarlo. */

/* MARK: - Unidades */

"unit.row" = "la fila %d";
"unit.column" = "la columna %d";
"unit.box" = "el bloque %d";

