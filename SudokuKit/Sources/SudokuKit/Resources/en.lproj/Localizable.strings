/* SudokuKit — the copy that teaches.

   Units carry their article in languages that have one ("la fila 4", "el bloque
   4"), so a sentence must never place a preposition that contracts with it
   directly before %@. In Spanish that means "en", never "de" or "a": "de el
   bloque 4" is not Spanish, and the translator cannot fix it from here. */

/* MARK: - Units */

"unit.row" = "row %d";
"unit.column" = "column %d";
"unit.box" = "box %d";

/* MARK: - Difficulty */

"difficulty.easy" = "Easy";
"difficulty.medium" = "Medium";
"difficulty.hard" = "Hard";
"difficulty.expert" = "Expert";

