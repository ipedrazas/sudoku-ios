/* MARK: - Pistas: una entrada equivocada

   Se comprueban antes que cualquier técnica, así que son las únicas que ve
   quien tiene un error en el tablero. %1$@ es una casilla en notación R5C2. */

"hint.mistake.nudge" = "Algo de aquí arriba no cuadra. Repasa lo que has puesto.";
"hint.mistake.locate" = "Hay un error en %@.";
"hint.mistake.explain" = "%1$@ contiene un %2$d, y no puede ser: así el sudoku se queda sin solución.";
"hint.mistake.reveal" = "%1$@ debería ser %2$d, no %3$d.";

/* MARK: - Pistas: no queda nada que hacer */

"hint.solved" = "Resuelto: no queda nada por encontrar.";
"hint.stuck.teaching" = "Este necesita una técnica que va más allá de mirar y de los patrones sencillos.";
"hint.stuck.none" = "No hay ninguna pista disponible.";

/* Se muestra cuando se pide otra pista y ya se ha explicado todo lo que se
   puede en esta posición. Ofrece una casilla en vez de pararse, porque "no
   tengo nada más" es donde se abandona la partida. */
"hint.allShown.offer" = "Ya te he explicado todo lo que puedo aquí. ¿Quieres que rellene %@?";

/* La respuesta, cuando ya se pide sin rodeos. La comparten todas las técnicas
   que colocan una cifra, porque solo hay una manera de decirlo. */
"hint.reveal.placement" = "%1$@ es %2$d.";

/* MARK: - Pistas: único desnudo */

"hint.nakedSingle.nudge" = "Hay una casilla en la que solo cabe un número.";
"hint.nakedSingle.locate" = "Fíjate en %@: solo encaja un número.";
"hint.nakedSingle.explain" = "Todos los números menos uno ya aparecen en la fila, la columna o el bloque de %@, así que solo queda ese.";

/* MARK: - Pistas: único oculto */

"hint.hiddenSingle.nudge" = "Hay un único oculto en %@.";
"hint.hiddenSingle.locate" = "En %@, a un número solo le queda una casilla donde ir.";
"hint.hiddenSingle.explain" = "%1$@ es la única casilla en %2$@ que puede llevar un %3$d: todas las demás están bloqueadas.";

/* MARK: - Pistas: candidato bloqueado */

"hint.lockedCandidate.nudge" = "Un número en %@ está atado a una sola línea.";
"hint.lockedCandidate.locate" = "En %1$@, el %2$d solo puede aparecer en %3$@.";
"hint.lockedCandidate.explain" = "Todos los sitios donde podría ir el %1$d en %2$@ caen en %3$@, así que el %1$d queda descartado en %4$@ de esa línea.";
"hint.lockedCandidate.reveal" = "Quita el %1$d de %2$@.";

/* MARK: - Pistas: pareja y trío desnudos */

"hint.nakedPair.nudge" = "Hay una pareja desnuda en %@.";
"hint.nakedTriple.nudge" = "Hay un trío desnudo en %@.";
"hint.nakedSubset.locate" = "Mira %1$@ en %2$@.";
/* "entre ellas", no "entre las dos": la misma frase sirve para la pareja y para
   el trío, y el inglés no distingue las dos ("between them"). */
"hint.nakedSubset.explain" = "%1$@ solo pueden llevar %2$@ entre ellas, así que esos números ya están pillados: ninguna otra casilla en %3$@ puede quedárselos.";
"hint.nakedSubset.reveal" = "Quita %1$@ de %2$@.";

/* MARK: - Pistas: pareja y trío ocultos */

"hint.hiddenPair.nudge" = "Hay una pareja oculta en %@.";
"hint.hiddenTriple.nudge" = "Hay un trío oculto en %@.";
"hint.hiddenSubset.locate" = "En %1$@, mira dónde pueden ir %2$@.";
"hint.hiddenSubset.explain" = "%1$@ solo pueden ir en %2$@, así que esas casillas no llevan nada más.";
"hint.hiddenSubset.reveal" = "Reduce %1$@ a %2$@.";

/* MARK: - Pistas: X-wing */

"hint.xWing.nudge" = "Hay un X-wing con el %d.";
"hint.xWing.locate" = "Compara %1$@: el %2$d ocupa las mismas dos posiciones en cada una.";
"hint.xWing.explain" = "El %1$d aparece exactamente en las mismas dos posiciones en %2$@. Caiga como caiga, esas dos líneas que las cruzan quedan cubiertas, así que el %1$d se descarta en el resto de ellas.";
"hint.xWing.reveal" = "Quita el %1$d de %2$@.";

/* MARK: - Listas */

"list.separator" = ", ";
"list.conjunction" = " y ";
